{
  "name": "ember-search-ui-driver",
  "version": "2.0.0",
  "description": "Framework-agnostic search driver: one flexible filter tree, codecs to any external filter spec",
  "keywords": [
    "search",
    "filters",
    "query-builder",
    "search-ui"
  ],
  "repository": "https://github.com/bengala-tech/ember-search-ui",
  "license": "MIT",
  "author": "Alberto Cantu <betocantu93@gmail.com> (https://betocantu93.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "eslint . --fix && prettier . --cache --write",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint .",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">= 20"
  }
}

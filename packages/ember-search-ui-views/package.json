{
  "name": "ember-search-ui-views",
  "version": "1.0.2",
  "description": "Default views (components and styles) for ember-search-ui",
  "keywords": [
    "ember-addon",
    "search-ui",
    "styles"
  ],
  "repository": "https://github.com/bengala-tech/ember-search-ui",
  "license": "MIT",
  "author": "Alberto Cantu <betocantu93@gmail.com> (https://betocantu93.com)",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0"
  },
  "dependencies": {
    "@ember/render-modifiers": "^4.0.0",
    "@embroider/addon-shim": "^1.8.9",
    "decorator-transforms": "^2.2.2",
    "ember-element-helper": "^0.8.8"
  },
  "peerDependencies": {
    "@glimmer/component": "^2.0.0",
    "ember-basic-dropdown": "^9.0.0",
    "ember-concurrency": "^5.1.0",
    "ember-power-select": "^9.0.0",
    "ember-search-ui": "workspace:^"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@babel/runtime": "^7.25.6",
    "@ember/app-tsconfig": "^1.0.0",
    "@ember/library-tsconfig": "^1.0.0",
    "@ember/test-helpers": "^5.2.1",
    "@ember/test-waiters": "^4.1.1",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.0",
    "@embroider/core": "^4.1.0",
    "@embroider/macros": "^1.20.1",
    "@embroider/vite": "^1.1.5",
    "@eslint/js": "^9.17.0",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.0.3",
    "@glint/template": "^1.6.1",
    "@glint/tsserver-plugin": "^2.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/qunit": "^2.19.12",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.2",
    "ember-source": "^6.7.0",
    "ember-strict-application-resolver": "^0.1.0",
    "ember-template-lint": "^7.9.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-ember": "^12.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.1",
    "globals": "^16.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "publint": "^0.3.16",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "rollup": "^4.22.5",
    "testem": "^3.15.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^7.1.9",
    "@elastic/search-ui": "^1.24.2",
    "ember-basic-dropdown": "^9.0.0",
    "ember-concurrency": "^5.3.0",
    "ember-power-select": "^9.0.2",
    "ember-search-ui": "workspace:*"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/autocomplete-input.js": "./dist/_app_/components/autocomplete-input.js",
      "./components/autocomplete-input/input.js": "./dist/_app_/components/autocomplete-input/input.js",
      "./components/autocomplete-input/items.js": "./dist/_app_/components/autocomplete-input/items.js",
      "./components/boolean-facet.js": "./dist/_app_/components/boolean-facet.js",
      "./components/error-boundary.js": "./dist/_app_/components/error-boundary.js",
      "./components/facet.js": "./dist/_app_/components/facet.js",
      "./components/facets.js": "./dist/_app_/components/facets.js",
      "./components/layout-sidebar.js": "./dist/_app_/components/layout-sidebar.js",
      "./components/layout.js": "./dist/_app_/components/layout.js",
      "./components/multi-checkbox-facet.js": "./dist/_app_/components/multi-checkbox-facet.js",
      "./components/paging-info.js": "./dist/_app_/components/paging-info.js",
      "./components/paging.js": "./dist/_app_/components/paging.js",
      "./components/result.js": "./dist/_app_/components/result.js",
      "./components/results-per-page.js": "./dist/_app_/components/results-per-page.js",
      "./components/results.js": "./dist/_app_/components/results.js",
      "./components/search-box.js": "./dist/_app_/components/search-box.js",
      "./components/single-links-facet.js": "./dist/_app_/components/single-links-facet.js",
      "./components/single-select-facet.js": "./dist/_app_/components/single-select-facet.js",
      "./components/sorting.js": "./dist/_app_/components/sorting.js",
      "./components/trigger.js": "./dist/_app_/components/trigger.js",
      "./helpers/build-autocomplete-groups.js": "./dist/_app_/helpers/build-autocomplete-groups.js",
      "./helpers/field-value-wrapper.js": "./dist/_app_/helpers/field-value-wrapper.js",
      "./helpers/get-escaped-field.js": "./dist/_app_/helpers/get-escaped-field.js",
      "./helpers/get-escaped-fields.js": "./dist/_app_/helpers/get-escaped-fields.js",
      "./helpers/get-field-type.js": "./dist/_app_/helpers/get-field-type.js",
      "./helpers/get-filter-value-display.js": "./dist/_app_/helpers/get-filter-value-display.js",
      "./helpers/get-raw.js": "./dist/_app_/helpers/get-raw.js",
      "./helpers/get-snippet.js": "./dist/_app_/helpers/get-snippet.js",
      "./helpers/get-suggestion-title.js": "./dist/_app_/helpers/get-suggestion-title.js",
      "./helpers/get-url-sanitizer.js": "./dist/_app_/helpers/get-url-sanitizer.js",
      "./helpers/html-escape.js": "./dist/_app_/helpers/html-escape.js",
      "./helpers/is-field-value-wrapper.js": "./dist/_app_/helpers/is-field-value-wrapper.js",
      "./helpers/map-facet-options.js": "./dist/_app_/helpers/map-facet-options.js",
      "./helpers/pick-value.js": "./dist/_app_/helpers/pick-value.js",
      "./helpers/to-locale-string.js": "./dist/_app_/helpers/to-locale-string.js",
      "./helpers/wrap-options.js": "./dist/_app_/helpers/wrap-options.js"
    }
  }
}
